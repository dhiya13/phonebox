<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP: the local agent over USB (adb reverse), and Home Assistant on this network when the computer is off
     (HaDirect allows plain HTTP only to private, Tailscale and .local / .lan / .home.arpa addresses). The agent over
     Wi-Fi is always HTTPS with a pinned certificate. The panel itself loads from https://appassets.androidplatform.net. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
